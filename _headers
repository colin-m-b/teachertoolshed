# Netlify headers. No build step: this file is deployed as-is from the repo root.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' blob: data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Long-lived, immutable assets. When a file here changes, change its name.
/css/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/teacher-tools/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else revalidates so a deploy is visible straight away.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
